# Copy to .env and fill in real values. The service REFUSES TO START if
# ADF_ADMIN_API_KEY or ADF_JWT_SECRET are missing/placeholder -- there are no
# insecure defaults.

# Static admin key guarding POST /tokens/root and break-glass endpoints (PRD 15).
ADF_ADMIN_API_KEY=change-me-admin-key-min-16-chars
# HS256 signing secret for capability tokens.
ADF_JWT_SECRET=change-me-jwt-secret-min-32-characters-long
# Salt for sha256 hashing of human identifiers in the audit log (PRD 8.6).
ADF_PII_SALT=change-me-pii-salt

ADF_DATABASE_URL=postgresql+psycopg://adf:adf@localhost:5432/adf
ADF_REDIS_URL=redis://localhost:6379/0

ADF_MAX_DELEGATION_DEPTH=5
ADF_RATE_LIMIT_DELEGATE_PER_MIN=60
ADF_RATE_LIMIT_VERIFY_PER_MIN=300
ADF_CIRCUIT_ERROR_RATE_THRESHOLD=0.25
ADF_CIRCUIT_MIN_SAMPLES=20
ADF_CIRCUIT_WINDOW_SECONDS=60
ADF_CIRCUIT_VOLUME_CEILING=10000
ADF_APPROVAL_TIMEOUT_SECONDS=300

# Agents exempt from rate limiting + circuit-breaker accounting so the
# item-8 load benchmark measures the checkpoint, not the guardrails.
ADF_GUARDRAIL_EXEMPT_AGENTS=bench-agent

ADF_CORS_ORIGINS=http://localhost:5173
